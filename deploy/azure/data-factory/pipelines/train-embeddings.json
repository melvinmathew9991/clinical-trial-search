{
  "name": "train-embeddings",
  "properties": {
    "description": "Retrain both embedding models and rebuild both indexes when a new corpus lands in blob storage.",
    "activities": [
      {
        "name": "train-models",
        "type": "DatabricksSparkPython",
        "dependsOn": [],
        "policy": {
          "timeout": "0.04:00:00",
          "retry": 1,
          "retryIntervalInSeconds": 120,
          "secureOutput": false,
          "secureInput": false
        },
        "typeProperties": {
          "pythonFile": "dbfs:/FileStore/medsearch/jobs/run_training.py",
          "parameters": ["--model", "all", "--field", "abstract"],
          "libraries": [
            { "whl": "dbfs:/FileStore/medsearch/wheels/medsearch-0.5.0-py3-none-any.whl" }
          ]
        },
        "linkedServiceName": {
          "referenceName": "MedSearchDatabricks",
          "type": "LinkedServiceReference"
        }
      },
      {
        "name": "build-index",
        "type": "DatabricksSparkPython",
        "dependsOn": [
          { "activity": "train-models", "dependencyConditions": ["Succeeded"] }
        ],
        "policy": {
          "timeout": "0.02:00:00",
          "retry": 1,
          "retryIntervalInSeconds": 120
        },
        "typeProperties": {
          "pythonFile": "dbfs:/FileStore/medsearch/jobs/run_indexing.py",
          "parameters": ["--model", "all", "--field", "abstract"],
          "libraries": [
            { "whl": "dbfs:/FileStore/medsearch/wheels/medsearch-0.5.0-py3-none-any.whl" }
          ]
        },
        "linkedServiceName": {
          "referenceName": "MedSearchDatabricks",
          "type": "LinkedServiceReference"
        }
      }
    ],
    "annotations": ["medsearch", "training"]
  }
}
