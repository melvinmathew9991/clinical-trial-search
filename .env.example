# Copy to .env and adjust. .env is gitignored — never commit real values.
# Every key is optional; the defaults in medsearch/config.py are tuned for a
# 4-core / 8 GB machine.

# ---------------------------------------------------------------- paths
MEDSEARCH_DATA_DIR=data
MEDSEARCH_MODEL_DIR=models
MEDSEARCH_REPORT_DIR=reports
MEDSEARCH_CORPUS_FILENAME=dimension-covid.csv

# ---------------------------------------------------------------- training
MEDSEARCH_VECTOR_SIZE=100
MEDSEARCH_WINDOW=5
MEDSEARCH_MIN_COUNT=2
MEDSEARCH_EPOCHS=5
MEDSEARCH_SEED=42

# FastText char n-grams.
# BUCKET IS THE MEMORY LEVER. gensim's default is 2_000_000, which at 100 dims
# x float32 is exactly 800 MB on disk and in RAM. Do not raise this without
# reading ADR-001 in Architecture.md.
MEDSEARCH_FASTTEXT_MIN_N=3
MEDSEARCH_FASTTEXT_MAX_N=5
MEDSEARCH_FASTTEXT_BUCKET=50000

# ---------------------------------------------------------------- resources
# Leave one logical core free so the desktop stays responsive.
# 0 means "auto" -> max(1, cpu_count - 1).
MEDSEARCH_WORKERS=0
MEDSEARCH_CHUNK_SIZE=1000
MEDSEARCH_MIN_FREE_MEMORY_GB=2.0
MEDSEARCH_WARN_FREE_MEMORY_GB=3.0
MEDSEARCH_MAX_ARTEFACT_MB=150

# ---------------------------------------------------------------- search
MEDSEARCH_TOP_N=10
MEDSEARCH_DEFAULT_MODEL=skipgram
MEDSEARCH_DEFAULT_FIELD=abstract

# ---------------------------------------------------------------- logging
MEDSEARCH_LOG_LEVEL=INFO
MEDSEARCH_LOG_JSON=false

# ---------------------------------------------------------------- azure (Sprint 10)
# Credentials are NEVER set here. Auth is via DefaultAzureCredential /
# managed identity. These are non-secret resource identifiers only, and even
# these live in App Service configuration in production, not in a file.
AZURE_STORAGE_ACCOUNT_URL=
AZURE_BLOB_CONTAINER=
AZURE_KEY_VAULT_URL=
